# Ingressi Environment Configuration
# Copy this file to .env and fill in the empty required values below.
# docker compose refuses to start until SESSION_SECRET and ADMIN_PASSWORD are
# set, and CLICKHOUSE_PASSWORD too while the clickhouse profile is active
# (COMPOSE_PROFILES below).
# Only the variables that docker-compose.yml lists in the web service's
# environment reach the web container; to use any other variable from
# documentation/configuration.md, add it there as well.
# IMPORTANT: chmod 600 .env after creating it

# =============================================================================
# REQUIRED SECURITY SETTINGS (PRODUCTION)
# =============================================================================

# Session Secret (REQUIRED)
# Generate with: openssl rand -base64 32
# Must be at least 32 characters in production; the example values from older
# versions of this file are rejected.
# It also encrypts stored secrets (DNS provider credentials, OAuth client
# secrets and tokens, certificate and CA private keys, instance sync tokens),
# so back it up together with the database. Instance sync master and slaves
# can each use their own (a slave derives the key that synced secrets are
# sealed to from it, and the master pins that key, so see below before
# changing it on a slave); a slave still on v1.12.0 or earlier needs its
# master's.
SESSION_SECRET=

# Rotating SESSION_SECRET: put the old value here (comma-separated for several)
# and recreate the web container (docker compose up -d). On startup every
# stored secret, a slave's synced ones included, is re-encrypted with the new
# SESSION_SECRET, so it can be removed after one successful start. On an
# instance sync slave, keep it until the master has synced to it once more:
# the master pinned the slave's old sync key and accepts the new one only when
# the slave proves it with the old secret (the master then logs "... proved
# its new sync key ...; pinned the new key"). Exception: while a slave's master
# runs v1.12.0 or earlier, which sends DNS provider credentials encrypted with
# its own SESSION_SECRET, the slave needs the master's secret here or as
# SESSION_SECRET. Values stored under an old example SESSION_SECRET are
# re-encrypted without it.
# SESSION_SECRET_PREVIOUS=

# Admin Credentials (REQUIRED)
# USERNAME: 3-255 characters from A-Z a-z 0-9 _ . @ - (e.g. "admin"); the
#   sign-in page refuses any other username and ignores case
# PASSWORD: Must be 12+ characters with:
#   - Uppercase letters (A-Z)
#   - Lowercase letters (a-z)
#   - Numbers (0-9)
#   - Special characters (!@#$%^&* etc.)
# They are applied when the admin account is created and whenever they change,
# so a password changed in the UI survives restarts. To recover a lost admin
# password, change ADMIN_PASSWORD here and recreate the web container
# (docker compose up -d; docker compose restart keeps the old values).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Allow public email/password account registration. Disabled by default.
AUTH_ALLOW_SELF_REGISTRATION=false

# Allow an OAuth sign-in to create a brand-new account for an unknown identity.
# Disabled by default: with OAuth enabled, existing users can still sign in (and
# link), but a first-time OAuth identity will NOT be auto-provisioned unless this
# is set to true. Enable it if OAuth is your intended onboarding path.
AUTH_ALLOW_OAUTH_REGISTRATION=false

# Trust a configured OAuth IdP to set a new user's role/status from its profile
# claims (e.g. a `role` claim). Disabled by default: role/status are forced to
# safe values (user/active) for OAuth-created accounts regardless of IdP claims.
# Only enable this if you control the IdP and intend it to manage roles.
AUTH_ALLOW_OAUTH_ROLE_FROM_CLAIMS=false

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Public base URL for the application (IMPORTANT!)
# This is the URL where users access your Ingressi interface.
#
# ** REQUIRED FOR OAUTH: If using OAuth2/OIDC authentication, this MUST match
#    the redirect URI configured in your OAuth provider exactly.
#    The redirect URI will be: {BASE_URL}/api/auth/callback/{provider-id}
#    (Settings -> OAuth Providers shows the exact URL)
#
# Examples:
#   - Local development: http://localhost:3000
#   - Production with domain: https://caddy-manager.example.com
#   - Production with IP: http://192.0.2.10:3000
#
# IMPORTANT: Do not include a trailing slash
BASE_URL=http://localhost:3000

# Ingressi forward auth: extra external ports on which protected sites are served.
# Leave empty when Caddy is published on the standard 80/443. Set this only if
# browsers reach protected sites on other ports (e.g. "8443" for a "8443:443"
# mapping); logins, redirects and sessions on any other non-standard port are
# refused, and the web container logs a warning naming the port. After a
# change, recreate the web container (docker compose up -d).
# FORWARD_AUTH_ALLOWED_PORTS=

# Request header holding the real client IP for the per-IP rate limits of the
# forward-auth portal login and the instance sync endpoint (e.g. x-real-ip or
# cf-connecting-ip). Leave unset when Caddy (including an Ingressi proxy host) is
# the outermost proxy in front of Ingressi: Caddy passes these headers through
# unchanged, and Ingressi then uses the rightmost X-Forwarded-For entry, which is
# the client. Behind a CDN (e.g. Cloudflare in front of Caddy) that entry is
# the CDN edge, so set the CDN's header, but only if the origin accepts
# connections from the CDN alone; otherwise clients can forge it. In general,
# set it only if every route to Ingressi sets or overwrites the header.
# TRUSTED_CLIENT_IP_HEADER=

# =============================================================================
# ROOTLESS OPERATION (OPTIONAL)
# =============================================================================

# User and Group IDs for running containers as non-root
# Set these to match your host user to avoid permission issues with volumes
# Find your UID/GID with: id -u / id -g
#
# Defaults:
#   - Web service: PUID=10001, PGID=10001
#   - Caddy service: PUID=10000, PGID=10000
#
# For matching your host user (recommended for development):
# PUID=1000
# PGID=1000

# =============================================================================
# OAUTH2/OIDC AUTHENTICATION (OPTIONAL)
# =============================================================================

# OAuth2/OIDC Provider (works with Authentik, Authelia, Keycloak, etc.)
# Enable OAuth2 authentication with any OIDC-compliant provider
OAUTH_ENABLED=false
OAUTH_PROVIDER_NAME=OAuth2             # Display name (e.g., "Authentik", "Keycloak")
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_ISSUER=                          # OIDC discovery URL (e.g., https://auth.example.com/application/o/app/)

# Optional: Override auto-discovered URLs (only if OIDC discovery doesn't work)
# OAUTH_AUTHORIZATION_URL=
# OAUTH_TOKEN_URL=
# OAUTH_USERINFO_URL=

# OAuth Settings
# Auto-link: trust this IdP to prove ownership of the Ingressi account with the same
# email (sign-in links automatically, and Profile linking is allowed). Leave it
# off for any IdP where users can set an arbitrary email themselves.
OAUTH_ALLOW_AUTO_LINKING=false

# Example for Authentik:
# OAUTH_ENABLED=true
# OAUTH_PROVIDER_NAME=Authentik
# OAUTH_CLIENT_ID=your-client-id
# OAUTH_CLIENT_SECRET=your-client-secret
# OAUTH_ISSUER=https://auth.example.com/application/o/caddy-proxy/
#
# IMPORTANT: Configure the redirect URI in your OAuth provider:
#   Redirect URI = {BASE_URL}/api/auth/callback/{provider-id}
#   The provider id is derived from OAUTH_PROVIDER_NAME; copy the exact
#   Callback URL from Settings -> OAuth Providers once the provider is synced.

# =============================================================================
# OPTIONAL: ADVANCED CONFIGURATION
# =============================================================================

# Database configuration (usually no need to change). For PostgreSQL see
# the POSTGRESQL section below.
# DATABASE_URL=file:/app/data/ingressi.db

# Caddy Admin API endpoint (usually no need to change)
# CADDY_API_URL=http://caddy:2019

# Caddy's admin API listens on a unix socket in a volume the web and caddy
# services share, so no proxied request inside the Caddy container can reach
# it over a port. The two variables must agree. To use the TCP port instead
# (for example dashboards on other machines than Caddy, which cannot share a
# socket), set CADDY_ADMIN_LISTEN=0.0.0.0:2019 and leave CADDY_ADMIN_SOCKET
# empty; never publish port 2019.
# CADDY_ADMIN_LISTEN=unix//run/caddy-admin/admin.sock|0660
# CADDY_ADMIN_SOCKET=/run/caddy-admin/admin.sock

# Where the dashboard reaches Caddy's HTTPS port (host:port) to read the
# certificates Caddy obtains: their expiry on the certificates page, expiry
# alerts, the overview and compliance checks. Defaults to the host of
# CADDY_API_URL on port 443. "off" turns this off. See documentation/certificates.md.
# CADDY_TLS_ADDRESS=caddy:443

# Certificate storage directory (usually no need to change)
# CERTS_DIRECTORY=./data/certs

# Rate limiting of forward-auth portal logins, password changes and OAuth
# account linking: LOGIN_MAX_ATTEMPTS failures within LOGIN_WINDOW_MS block a
# client (for password changes and account linking: the user's account) for
# LOGIN_BLOCK_MS; portal logins also have a per-account ceiling derived from
# them (see documentation/forward-auth.md, "Login rate limits"). Dashboard
# sign-in is limited by Better Auth instead (3 requests per 10 seconds per
# client; AUTH_RATE_LIMIT_ENABLED=false turns Better Auth's limits off, see
# documentation/configuration.md).
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_WINDOW_MS=300000
# LOGIN_BLOCK_MS=900000

# Instance sync (master only): time limit in milliseconds for one sync request
# to a slave, covering the upload and the slave's apply including its Caddy
# reload. Clamped to 5000..300000; 0 or empty means the default.
# INSTANCE_SYNC_TIMEOUT_MS=60000

# Pull replica (fleet management; see ee/docs/fleet.md): a slave
# the master cannot reach polls it instead. Add the replica on the master
# (Fleet -> Pull replicas), which shows these values once.
# INSTANCE_SYNC_MODE=pull
# INSTANCE_MASTER_URL=https://dash.example.com
# INSTANCE_PULL_TOKEN=
# INSTANCE_PULL_INTERVAL=30


# =============================================================================
# DOCKER COMPOSE PROFILES
# =============================================================================

# Comma-separated list of profiles to activate.
# Available profiles:
#   clickhouse   ClickHouse analytics database (traffic and WAF events, kept 30 days by default)
#   geoipupdate  MaxMind GeoLite2 database updates (needed for geo blocking)
#
# To disable analytics, remove "clickhouse" from this list (or leave it empty).
# To combine profiles: COMPOSE_PROFILES=clickhouse,geoipupdate
COMPOSE_PROFILES=clickhouse

# =============================================================================
# CLICKHOUSE ANALYTICS
# =============================================================================

# Required when the clickhouse profile is active.
# Generate with: openssl rand -base64 32
CLICKHOUSE_PASSWORD=
# CLICKHOUSE_URL=http://clickhouse:8123
# CLICKHOUSE_USER=ingressi
# CLICKHOUSE_DB=analytics

# How long analytics events (traffic + WAF) are retained before ClickHouse's
# TTL deletes them. Defaults to 30 days. Lower this to use less disk space.
# Changing it migrates the existing tables' TTL on the next startup.
# CLICKHOUSE_RETENTION_DAYS=30

# =============================================================================
# GEOIP UPDATE (OPTIONAL)
# =============================================================================

# GeoLite2 database updates, needed for geo blocking.
# Add "geoipupdate" to COMPOSE_PROFILES above, then fill in credentials.
# Get credentials at: https://www.maxmind.com/en/geolite2/signup
GEOIPUPDATE_ACCOUNT_ID=
GEOIPUPDATE_LICENSE_KEY=

# =============================================================================
# POSTGRESQL (OPTIONAL)
# =============================================================================

# The dashboard's data in PostgreSQL instead of SQLite (documentation/postgresql.md),
# with the override that runs PostgreSQL 17 next to it:
#   docker compose -f docker-compose.yml -f docker-compose.postgres.yml up -d
# Or set COMPOSE_FILE=docker-compose.yml:docker-compose.postgres.yml here.
# Letters and digits only (it goes into DATABASE_URL as it is).
# Generate with: openssl rand -hex 32
# POSTGRES_PASSWORD=

# Several dashboard replicas on that database (ee/docs/high-availability.md,
# "PostgreSQL replicas"): add "replicas" to COMPOSE_PROFILES to start web-2, and
# list the replicas Caddy sends forward-auth checks, sign-in callbacks and the
# API gate to (host:port, comma-separated; the same on every replica). Empty
# means the single web container, as without replicas.
# DASHBOARD_UPSTREAMS=web:3000,web-2:3000

# =============================================================================
# HIGH AVAILABILITY: DASHBOARD CLUSTER (OPTIONAL)
# =============================================================================

# One leader and warm standbys, SQLite streamed to S3-compatible storage with
# Litestream (ee/docs/high-availability.md). Used by the example override:
#   docker compose -f docker-compose.yml -f docker-compose.ha.yml up -d
# HA_REDIS_PASSWORD=
# HA_S3_ACCESS_KEY_ID=
# HA_S3_SECRET_ACCESS_KEY=
