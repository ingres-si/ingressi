{
  "name": "ingressi",
  "version": "1.0.0",
  "description": "Ingressi: self-hosted reverse proxy built on Caddy (formerly Caddy Proxy Manager).",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "NODE_OPTIONS=--max-old-space-size=4096 eslint .",
    "typecheck": "tsc --noEmit && tsc6 --noEmit",
    "test:all": "./scripts/test-all.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:generate-pg-schema": "bun scripts/db/generate-pg-schema.ts",
    "db:check-pg-schema": "bun scripts/db/generate-pg-schema.ts --check",
    "db:copy-to-postgres": "bun scripts/db/copy-sqlite-to-postgres.ts",
    "codemod:db-async": "bun scripts/codemods/db-async/transform.ts",
    "codemod:db-async:analyze": "bun scripts/codemods/db-async/analyze.ts",
    "bench:db": "NODE_ENV=production bun scripts/bench/db-hot-paths.ts",
    "bench:db-copy": "bun scripts/db/copy-benchmark.ts",
    "test": "vitest run --config tests/vitest.config.ts",
    "test:pg": "TEST_DB_DIALECT=postgres vitest run --config tests/vitest.config.ts --project postgres",
    "test:watch": "vitest --config tests/vitest.config.ts",
    "test:ui": "vitest --ui --config tests/vitest.config.ts",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "test:e2e:ui": "playwright test --ui --config tests/playwright.config.ts",
    "test:e2e:headed": "playwright test --headed --config tests/playwright.config.ts",
    "test:e2e:no-clickhouse": "playwright test --config tests/playwright.no-clickhouse.config.ts",
    "test:e2e:pg": "playwright test --config tests/playwright.pg.config.ts",
    "test:e2e:replicas": "playwright test --config tests/playwright.replicas.config.ts",
    "screenshots:site": "playwright test --config tests/playwright.shots.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@better-auth/passkey": "1.7.12",
    "@clickhouse/client": "^1.24.1",
    "@coinbase/x402": "2.1.0",
    "@node-saml/node-saml": "5.1.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@simplewebauthn/browser": "14.0.0",
    "@swagger-api/apidom-core": "1.12.1",
    "@swagger-api/apidom-ns-openapi-3-1": "1.12.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@xmldom/xmldom": "0.9.12",
    "autoprefixer": "^10.6.1",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-geo": "^3.1.1",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "drizzle-orm": "^0.45.4",
    "ioredis": "6.0.0",
    "kysely": "0.29.7",
    "ldapts": "9.2.0",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "^6.15.0",
    "maxmind": "^5.0.7",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "node-forge": "^1.4.0",
    "nodemailer": "^10.2.1",
    "pg": "8.23.1",
    "postcss": "^8.5.31",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-map-gl": "^8.1.3",
    "sonner": "^2.0.8",
    "swagger-ui-react": "5.34.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
